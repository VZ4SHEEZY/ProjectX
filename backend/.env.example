# CyberDope Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/cyberdope

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Authenticates internal tip confirmation callbacks
TIP_WEBHOOK_SECRET=generate-a-long-random-secret

# Anthropic Claude API (for AI features)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Cloudinary (for image/video uploads in production)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Web3/WalletConnect (for crypto payments)
WALLET_CONNECT_PROJECT_ID=your-walletconnect-project-id
BASE_SEPOLIA_RPC_URL=https://your-dedicated-base-sepolia-rpc.example/v1/secret
USDC_SEPOLIA_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
TIP_ROUTER_CONTRACT_ADDRESS=0x-your-verified-base-sepolia-contract
TIP_ROUTER_CODE_HASH=0x-runtime-bytecode-hash-from-independent-verification
TIP_ROUTER_TREASURY_ADDRESS=0x-your-verified-recipient
# Fail-closed gate. Set true only after independent on-chain verification and E2E test.
PAYMENT_EXECUTION_ENABLED=false

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis (for caching and sessions - optional)
REDIS_URL=redis://localhost:6379
