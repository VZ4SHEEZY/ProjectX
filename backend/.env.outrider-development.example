NODE_ENV=development
OUTRIDER_ENV=development
# Must name a non-production database (for example cyberdope_out_rider_dev).
OUTRIDER_MONGODB_URI=mongodb://127.0.0.1:27017/cyberdope_out_rider_dev
# Canonical staging User ID attributable as the server-side grantor.
OUTRIDER_SEED_GRANTED_BY_USER_ID=000000000000000000000001
OUTRIDER_ENABLED=true
OUTRIDER_GLASS_ENABLED=true
OUTRIDER_SIGNAL_INGESTION_ENABLED=true
OUTRIDER_PROPOSALS_ENABLED=true
OUTRIDER_RUNTIME_ENABLED=true
OUTRIDER_OBSERVER_ENABLED=true
OUTRIDER_MAX_ACTIONS_PER_TICK=1
OUTRIDER_MAX_AGENTS_PER_RUN=4
OUTRIDER_EXECUTION_TIMEOUT_MS=5000
OUTRIDER_MAX_TOKENS_PER_RUN=2000
OUTRIDER_AGENT_COOLDOWN_MS=1000
