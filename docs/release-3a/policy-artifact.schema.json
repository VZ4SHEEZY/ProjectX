{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdope.example/schemas/progression-policy-artifact/1.0.0",
  "title": "Immutable progression policy artifact metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyId", "version", "code", "config", "codeDigest", "configDigest", "detectorVersions", "evidenceContractVersions", "evidenceEligibility", "taxonomyVersion", "numericRules", "roundingRules", "runtimeCompatibility", "serialization", "artifactDigest"],
  "properties": {
    "policyId": { "type": "string", "minLength": 1, "maxLength": 256 }, "version": { "type": "string", "minLength": 1, "maxLength": 256 },
    "code": { "type": "string", "minLength": 1, "maxLength": 262144 }, "config": { "type": "object", "maxProperties": 256 },
    "codeDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "configDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "detectorVersions": { "type": "object", "maxProperties": 256 }, "evidenceContractVersions": { "type": "object", "maxProperties": 256 }, "evidenceEligibility": { "type": "object", "maxProperties": 256 },
    "taxonomyVersion": { "type": "string", "minLength": 1, "maxLength": 256 }, "numericRules": { "type": "object", "maxProperties": 256 },
    "roundingRules": { "type": "object" }, "runtimeCompatibility": { "type": "object" },
    "serialization": { "const": "RFC8785-compatible-stable-json-v1" }, "artifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
