{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdope.example/schemas/activity-event/1.1.0",
  "title": "CyberDope canonical immutable raw activity event",
  "description": "Facts and evidence references only. Qualification and mutable policy interpretation are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "idempotencyKey", "schemaVersion", "eventType", "activityClass", "actorId", "beneficiaryId", "occurredAt", "ingestedAt", "affiliations", "provenance", "sourceIdentity", "evidenceRefs", "attributes"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.1.0" },
    "eventType": { "type": "string", "minLength": 1 },
    "activityClass": { "enum": ["CREATE", "ENGAGE", "ACHIEVE", "TRANSACT"] },
    "actorId": { "type": "string", "minLength": 1 },
    "subject": { "$ref": "#/$defs/nullableEntityRef" },
    "object": { "$ref": "#/$defs/nullableEntityRef" },
    "beneficiaryId": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "ingestedAt": { "type": "string", "format": "date-time" },
    "affiliations": {
      "type": "object", "additionalProperties": false, "required": ["actor", "beneficiary"],
      "properties": { "actor": { "$ref": "#/$defs/affiliation" }, "beneficiary": { "$ref": "#/$defs/affiliation" } }
    },
    "provenance": {
      "type": "object", "additionalProperties": true, "required": ["service"],
      "properties": { "service": { "type": "string", "minLength": 1 }, "sourceEventId": { "type": "string" }, "traceId": { "type": "string" } }
    },
    "sourceIdentity": {
      "type": "object", "additionalProperties": true, "required": ["objectType", "objectId", "transition", "version"],
      "properties": { "objectType": { "type": "string", "minLength": 1 }, "objectId": { "type": "string", "minLength": 1 }, "transition": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "economic": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["amountMinor", "currency", "status"],
      "properties": { "amountMinor": { "type": "string", "pattern": "^[0-9]+$" }, "currency": { "type": "string" }, "status": { "enum": ["pending", "final", "failed", "reversed", "refunded", "chargeback"] }, "providerReference": { "type": "string" } }
    },
    "correction": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/correction" }] },
    "attributes": { "type": "object", "description": "Non-sensitive immutable facts or evidence references; policy interpretation and secrets are forbidden." }
  },
  "$defs": {
    "nullableEntityRef": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/entityRef" }] },
    "entityRef": { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "type": "string" }, "id": { "type": "string" } } },
    "affiliation": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state", "factionId", "effectiveAt", "source"], "properties": { "state": { "const": "affiliated" }, "factionId": { "type": "string", "minLength": 1 }, "membershipRef": { "type": "string" }, "effectiveAt": { "type": "string", "format": "date-time" }, "source": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "const": "unaffiliated" }, "effectiveAt": { "type": "string", "format": "date-time" }, "source": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "const": "unknown" }, "effectiveAt": { "type": "string", "format": "date-time" }, "source": { "type": "string" } } }
      ]
    },
    "correction": {
      "type": "object", "additionalProperties": false,
      "required": ["targetEventId", "type", "authority", "effectiveAt", "evidenceRefs", "sequence"],
      "properties": {
        "targetEventId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["moderation_reversal", "reversal", "refund", "chargeback", "supersession", "amendment"] },
        "authority": { "type": "string", "minLength": 1 },
        "effectiveAt": { "type": "string", "format": "date-time" },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "sequence": { "type": "integer", "minimum": 1 },
        "replacementEventId": { "type": "string" },
        "compensatingEventId": { "type": "string" }
      },
      "allOf": [{ "if": { "properties": { "type": { "enum": ["supersession", "amendment"] } }, "required": ["type"] }, "then": { "required": ["replacementEventId"] } }]
    }
  }
}
