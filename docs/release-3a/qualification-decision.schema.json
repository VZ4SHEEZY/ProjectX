{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdope.example/schemas/qualification-decision/1.0.0",
  "title": "CyberDope append-only qualification decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "eventId", "policyId", "policyVersion", "evaluationGeneration", "evidenceGeneration", "correctionGraphGeneration", "evidenceSetDigest", "correctionGraphDigest", "projectionContextId", "cutoff", "watermark", "state", "factor", "contributionResult", "reasonCodes", "evidenceRefs", "evaluatedAt", "policyArtifactDigest", "signals"],
  "properties": {
    "decisionId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "eventId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "policyId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "policyVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
    "evaluationGeneration": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
    "evidenceGeneration": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
    "correctionGraphGeneration": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
    "state": { "enum": ["quarantined", "qualified", "diminished", "rejected"] },
    "factor": { "type": "number", "minimum": 0, "maximum": 1 },
    "contributionResult": { "type": "object", "additionalProperties": false, "required": ["factor"], "properties": { "factor": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "reasonCodes": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "maxLength": 128 }, "description": "INTERNAL RESTRICTED qualification reasons. Never expose directly through public projection APIs." },
    "evidenceRefs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{32}$" } },
    "evaluatedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "cutoff": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "watermark": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "policyArtifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceSetDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "correctionGraphDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "projectionContextId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signals": { "type": "object", "additionalProperties": false, "properties": { "uniquePeople": { "type": "number" }, "uniqueFactions": { "type": "number" }, "trustConfidence": { "type": "number" }, "valueSignal": { "type": "number" }, "engagementDiversity": { "type": "number" }, "linkedAccount": { "type": "boolean" }, "linkedWallet": { "type": "boolean" }, "circularTransfer": { "type": "boolean" }, "sybilConfidence": { "type": "number" }, "botGenerated": { "type": "boolean" }, "botDisclosure": { "type": "boolean" }, "velocityPerHour": { "type": "number" }, "repeatOrdinal": { "type": "number" }, "reciprocalDensity": { "type": "number" }, "sameFactionDensity": { "type": "number" }, "lowValueRatio": { "type": "number" }, "uniqueSupporters": { "type": "number" }, "moderated": { "type": "boolean" }, "abusive": { "type": "boolean" }, "reportManipulation": { "type": "boolean" } }, "description": "INTERNAL RESTRICTED bounded categorical/numeric outputs; raw payment, moderation, graph, location, identity, and allegiance data are forbidden." }
  }
}
