{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdope.example/schemas/progression-evidence/1.0.0",
  "title": "Versioned progression evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceId", "type", "contractVersion", "subject", "producer", "generation", "observedAt", "confidence", "lineage", "evidenceDigest", "privacyClassification", "retentionClass", "body"],
  "properties": {
    "evidenceId": { "type": "string", "minLength": 1 },
    "type": { "enum": ["reach", "moderation", "fraud_trust", "economic_finality"] },
    "contractVersion": { "type": "string", "minLength": 1 },
    "subject": { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "type": "string" }, "id": { "type": "string" } } },
    "producer": { "type": "string", "minLength": 1 },
    "generation": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "lineage": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidenceDigest": { "type": "string", "minLength": 1 },
    "supersedesEvidenceId": { "type": ["string", "null"] },
    "privacyClassification": { "enum": ["public_aggregate", "internal", "restricted", "highly_restricted"] },
    "retentionClass": { "type": "string", "minLength": 1 },
    "body": { "type": "object" }
  }
}
