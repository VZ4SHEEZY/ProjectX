{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberdope.example/schemas/progression-evidence/1.0.0",
  "title": "Versioned progression evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceId", "type", "contractVersion", "subject", "producer", "generation", "observedAt", "confidence", "lineage", "evidenceDigest", "privacyClassification", "retentionClass", "body"],
  "properties": {
    "evidenceId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "type": { "enum": ["reach", "moderation", "fraud_trust", "economic_finality"] },
    "contractVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
    "subject": { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "type": "string", "minLength": 1, "maxLength": 256 }, "id": { "type": "string", "minLength": 1, "maxLength": 256 } } },
    "producer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "generation": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
    "observedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "lineage": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "evidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "supersedesEvidenceId": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{32}$" }] },
    "privacyClassification": { "enum": ["public_aggregate", "internal", "restricted", "highly_restricted"] },
    "retentionClass": { "type": "string", "minLength": 1, "maxLength": 256 },
    "body": {
      "oneOf": [
        { "$ref": "#/$defs/reachBody" },
        { "$ref": "#/$defs/moderationBody" },
        { "$ref": "#/$defs/fraudTrustBody" },
        { "$ref": "#/$defs/economicFinalityBody" }
      ]
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "reach" } }, "required": ["type"] }, "then": { "properties": { "body": { "$ref": "#/$defs/reachBody" } } } },
    { "if": { "properties": { "type": { "const": "moderation" } }, "required": ["type"] }, "then": { "properties": { "body": { "$ref": "#/$defs/moderationBody" } } } },
    { "if": { "properties": { "type": { "const": "fraud_trust" } }, "required": ["type"] }, "then": { "properties": { "body": { "$ref": "#/$defs/fraudTrustBody" } } } },
    { "if": { "properties": { "type": { "const": "economic_finality" } }, "required": ["type"] }, "then": { "properties": { "body": { "$ref": "#/$defs/economicFinalityBody" } } } }
  ],
  "$defs": {
    "reachBody": {
      "type": "object", "additionalProperties": false,
      "required": ["windowStart", "windowEnd", "deduplicationMethod", "audienceAggregate", "uniquePeople", "uniqueFactions", "sameFaction", "crossFaction", "unaffiliated", "unknownOrIneligible", "sourceChannel"],
      "properties": {
        "windowStart": { "type": "string", "format": "date-time" }, "windowEnd": { "type": "string", "format": "date-time" },
        "deduplicationMethod": { "type": "string", "minLength": 1 }, "audienceAggregate": { "type": "string", "minLength": 1 },
        "uniquePeople": { "type": "integer", "minimum": 0 }, "uniqueFactions": { "type": "integer", "minimum": 0 },
        "sameFaction": { "type": "integer", "minimum": 0 }, "crossFaction": { "type": "integer", "minimum": 0 },
        "unaffiliated": { "type": "integer", "minimum": 0 }, "unknownOrIneligible": { "type": "integer", "minimum": 0 },
        "sourceChannel": { "type": "string", "minLength": 1 }, "actorAffiliationRef": { "type": "string" }, "beneficiaryAffiliationRef": { "type": "string" }
      }
    },
    "moderationBody": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "authorityRef", "caseRef", "targetEventId"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1, "maxLength": 256 }, "authorityRef": { "type": "string", "minLength": 1, "maxLength": 256 }, "caseRef": { "type": "string", "minLength": 1, "maxLength": 256 },
        "targetEventId": { "type": "string", "pattern": "^[a-f0-9]{32}$" }, "targetObject": { "$ref": "#/$defs/entityRef" }, "replacementEventId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "priorVersion": { "type": "string", "minLength": 1, "maxLength": 256 }, "replacementVersion": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "fraudTrustBody": {
      "type": "object", "additionalProperties": false, "required": ["detectorVersion", "signals"],
      "properties": { "detectorVersion": { "type": "string", "minLength": 1, "maxLength": 256 }, "signals": { "type": "object", "additionalProperties": false, "properties": { "trustConfidence": { "type": "number" }, "valueSignal": { "type": "number" }, "engagementDiversity": { "type": "number" }, "linkedAccount": { "type": "boolean" }, "linkedWallet": { "type": "boolean" }, "circularTransfer": { "type": "boolean" }, "sybilConfidence": { "type": "number" }, "botGenerated": { "type": "boolean" }, "botDisclosure": { "type": "boolean" }, "velocityPerHour": { "type": "number" }, "repeatOrdinal": { "type": "number" }, "reciprocalDensity": { "type": "number" }, "sameFactionDensity": { "type": "number" }, "lowValueRatio": { "type": "number" }, "uniqueSupporters": { "type": "number" }, "moderated": { "type": "boolean" }, "abusive": { "type": "boolean" }, "reportManipulation": { "type": "boolean" } }, "description": "INTERNAL RESTRICTED: categorical/versioned detector output only; no raw graphs, identities, locations, allegiance, or free-form signals." } }
    },
    "economicFinalityBody": {
      "type": "object", "additionalProperties": false, "required": ["state", "authorityRef", "transactionRef"],
      "properties": { "state": { "enum": ["intent", "pending", "confirmed", "finalized", "failed", "refund", "chargeback", "chain_reorganization", "reversed"] }, "authorityRef": { "type": "string", "minLength": 1, "maxLength": 256 }, "transactionRef": { "type": "string", "minLength": 1, "maxLength": 256 }, "blockRef": { "type": "string", "minLength": 1, "maxLength": 256 }, "confirmationDepth": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "amountMinor": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,77})$" }, "currency": { "type": "string", "pattern": "^[A-Z]{3,8}$" }, "payerId": { "type": "string", "minLength": 1, "maxLength": 256 }, "beneficiaryId": { "type": "string", "minLength": 1, "maxLength": 256 }, "recipientId": { "type": "string", "minLength": 1, "maxLength": 256 }, "compensatingTransactionRef": { "type": "string", "minLength": 1, "maxLength": 256 }, "direction": { "enum": ["payer_to_beneficiary", "beneficiary_to_payer", "void_original"] }, "amountSign": { "const": "non_negative_magnitude" } }
    },
    "entityRef": { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "type": "string", "minLength": 1, "maxLength": 256 }, "id": { "type": "string", "minLength": 1, "maxLength": 256 } } }
  }
}
