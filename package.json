    "autoprefixer": "^10.5.4",
    "ethers": "^6.17.0",
    "hardhat": "^3.14.0",
    "mongodb-memory-server": "^11.2.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  }
