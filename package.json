    "test:e2e": "playwright test",
    "test:e2e:external": "EXTERNAL_E2E=1 playwright test e2e/external-wallet.spec.ts --project=desktop-chromium",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
