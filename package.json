    "@tanstack/react-query": "^5.101.4",
    "@wagmi/connectors": "^8.0.25",
    "@wagmi/core": "^3.6.4",
    "axios": "^1.6.0",
    "lucide-react": "^0.555.0",
    "prop-types": "15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "1.4.4",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.0.10",
    "react-resizable": "3.0.5",
    "socket.io-client": "^4.7.2",
