{
  "name": "cyberdope",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy:base-sepolia": "npm run contracts:compile && node backend/scripts/deploy-tiprouter-sepolia.js",
